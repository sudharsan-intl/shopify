{% if cart.item_count > 0 %}
<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-gray-200 pb-10">
      <div>
        <p class="text-sm uppercase tracking-[0.3em] text-gray-400">Your bag</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">
          {{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %} ready to ship
        </h1>
      </div>
      <a href="/collections/all" class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-5 py-2 text-sm font-medium text-gray-600 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900">
        Continue shopping
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <form action="/cart" method="post" novalidate class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)]">
      <div class="space-y-6">
        {% for item in cart.items %}
          {% assign decreased_quantity = item.quantity | minus: 1 %}
          {% if decreased_quantity < 0 %}
            {% assign decreased_quantity = 0 %}
          {% endif %}
          {% assign increased_quantity = item.quantity | plus: 1 %}
          {% assign line_image = item.image %}
          {% assign has_discount = item.original_line_price %}
          <article class="relative overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-sm shadow-gray-100/70 transition hover:border-gray-200 hover:shadow-lg">
            <div class="flex flex-col gap-6 p-6 sm:flex-row sm:items-center">
              <a href="{{ item.url }}" class="flex-shrink-0 overflow-hidden rounded-2xl bg-gray-100 sm:w-48">
                {% if line_image %}
                  <img src="{{ line_image | img_url: '540x' }}" alt="{{ item.title | escape }}" class="h-48 w-48 object-cover transition duration-500 hover:scale-105" loading="lazy">
                {% else %}
                  <div class="flex h-48 w-48 items-center justify-center bg-gray-100 text-xs font-semibold uppercase tracking-[0.3em] text-gray-400">No image</div>
                {% endif %}
              </a>
              <div class="flex w-full flex-col gap-4">
                <div class="flex flex-col gap-1">
                  <a href="{{ item.url }}" class="text-lg font-semibold text-gray-900 transition hover:text-gray-600">{{ item.product.title }}</a>
                  {% unless item.variant.title contains 'Default' %}
                    <p class="text-sm text-gray-500">{{ item.variant.title }}</p>
                  {% endunless %}
                  {% if item.properties.size > 0 %}
                    <dl class="mt-1 space-y-1 text-xs text-gray-400">
                      {% for p in item.properties %}
                        {% unless p.last == blank %}
                          <div class="flex gap-2">
                            <dt class="uppercase tracking-[0.25em]">{{ p.first }}:</dt>
                            <dd>{{ p.last }}</dd>
                          </div>
                        {% endunless %}
                      {% endfor %}
                    </dl>
                  {% endif %}
                </div>

                <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
                  <div class="flex items-baseline gap-3">
                    <span class="text-lg font-semibold text-gray-900">{{ item.final_price | money }}</span>
                    {% if has_discount %}
                      <span class="text-sm text-gray-400 line-through">{{ item.original_price | money }}</span>
                    {% endif %}
                  </div>
                  {% if item.line_level_discount_allocations.size > 0 %}
                    <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-emerald-700">
                      {% for allocation in item.line_level_discount_allocations %}
                        <span>{{ allocation.discount_application.title }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>

                <div class="flex flex-wrap items-center gap-4">
                  <label for="updates_{{ item.key }}" class="text-sm font-medium text-gray-600">Quantity</label>
                  <div class="inline-flex items-center overflow-hidden rounded-full border border-gray-200">
                    <a href="/cart/change?line={{ forloop.index }}&amp;quantity={{ decreased_quantity }}" class="grid h-11 w-11 place-items-center text-gray-500 transition hover:bg-gray-50 hover:text-gray-900" aria-label="Decrease quantity">
                      &minus;
                    </a>
                    <input type="number" id="updates_{{ item.key }}" name="updates[]" value="{{ item.quantity }}" min="0" class="h-11 w-16 border-x border-gray-200 text-center text-sm font-semibold text-gray-700 focus:outline-none">
                    <a href="/cart/change?line={{ forloop.index }}&amp;quantity={{ increased_quantity }}" class="grid h-11 w-11 place-items-center text-gray-500 transition hover:bg-gray-50 hover:text-gray-900" aria-label="Increase quantity">
                      +
                    </a>
                  </div>
                  <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" class="text-sm font-medium text-gray-400 underline underline-offset-4 hover:text-rose-500">Remove</a>
                </div>
              </div>
            </div>

            <div class="border-t border-gray-100 bg-gray-50/70 px-6 py-4 text-sm text-gray-500">
              <span>Item total</span>
              <span class="float-right font-semibold text-gray-900">{{ item.line_price | money }}</span>
            </div>
          </article>
        {% endfor %}
      </div>

      <aside class="space-y-6">
        <div class="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm shadow-gray-100/70">
          <h2 class="text-lg font-semibold text-gray-900">Order summary</h2>
          <dl class="mt-6 space-y-4 text-sm text-gray-600">
            <div class="flex justify-between">
              <dt>Subtotal</dt>
              <dd class="font-medium text-gray-900">{{ cart.subtotal_price | money }}</dd>
            </div>
            {% if cart.total_discounts > 0 %}
              <div class="flex justify-between text-emerald-700">
                <dt>Discounts</dt>
                <dd>- {{ cart.total_discounts | money }}</dd>
              </div>
            {% endif %}
            <div class="flex justify-between">
              <dt>Shipping</dt>
              <dd class="text-gray-400">Calculated at checkout</dd>
            </div>
            <div class="flex justify-between border-t border-gray-200 pt-4 text-base font-semibold text-gray-900">
              <dt>Total</dt>
              <dd>{{ cart.total_price | money_with_currency }}</dd>
            </div>
          </dl>

          <div class="mt-6 space-y-3">
            <button type="submit" name="checkout" class="w-full rounded-full bg-gray-900 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-white transition hover:bg-gray-700">
              Checkout
            </button>
            <button type="submit" name="update" class="w-full rounded-full border border-gray-200 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-gray-600 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900">
              Update quantities
            </button>
          </div>

          <p class="mt-6 text-xs text-gray-500">
            Need help? <a href="/pages/contact" class="font-semibold text-gray-700 underline decoration-gray-300 underline-offset-4 hover:text-gray-900">Chat with our concierge</a>.
          </p>
        </div>

        <div class="rounded-3xl border border-amber-200/80 bg-amber-50/80 p-5 text-sm text-amber-900 shadow-sm shadow-amber-100/50">
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 3 2 9l10 6 10-6-10-6z"/>
              <path d="m2 15 10 6 10-6"/>
              <path d="m2 9 10 6 10-6"/>
            </svg>
            <p>
              Complimentary shipping on orders over Rs 999. All orders are packed in reusable, recycled materials.
            </p>
          </div>
        </div>
      </aside>
    </form>
  </div>
</section>
{% else %}
<section class="bg-white">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 py-24 text-center sm:px-6 lg:px-8">
    <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-gray-100 text-gray-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 3h2l2.6 11.4a1 1 0 0 0 1 .8H18a1 1 0 0 0 1-.8L21 7H6"/>
        <circle cx="9" cy="20" r="1.5"/>
        <circle cx="18" cy="20" r="1.5"/>
      </svg>
    </span>
    <div class="space-y-2">
      <h1 class="text-3xl font-semibold text-gray-900">Your cart is currently empty</h1>
      <p class="text-sm text-gray-500">Discover our newest arrivals and curated collections crafted to elevate every day.</p>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/collections/all" class="rounded-full bg-gray-900 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-white transition hover:bg-gray-700">
        Explore collections
      </a>
      <a href="/" class="rounded-full border border-gray-200 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-gray-600 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900">
        Back to home
      </a>
    </div>
  </div>
</section>
{% endif %}
