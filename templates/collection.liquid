{% paginate collection.products by 12 %}
<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 border-b border-gray-200 pb-10 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm uppercase tracking-[0.3em] text-gray-400">Collection</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <div class="prose prose-sm mt-4 max-w-2xl text-gray-600 sm:prose-base">
            {{ collection.description }}
          </div>
        {% endif %}
      </div>
      <div class="rounded-3xl border border-gray-200 bg-gray-50/80 px-6 py-5 text-sm text-gray-600 shadow-sm shadow-gray-200/60">
        <p class="font-medium text-gray-700">{{ collection.all_products_count }} product{% if collection.all_products_count != 1 %}s{% endif %}</p>
        {% if collection.sort_options.size > 0 %}
          <form method="get" class="mt-3">
            <label for="collection-sort" class="sr-only">Sort results</label>
            <select id="collection-sort"
                    name="sort_by"
                    class="w-full rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm focus:border-gray-400 focus:outline-none">
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                  {{ option.name }}
                </option>
              {% endfor %}
            </select>
          </form>
        {% endif %}
      </div>
    </div>

    {% if collection.products_count > 0 %}
      <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {% for product in collection.products %}
          {% assign on_sale = product.compare_at_price_max > product.price %}
          {% assign primary_image = product.featured_image %}
          {% assign secondary_image = product.images[1] %}
          <article class="group relative overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-sm shadow-gray-100/80 transition duration-500 hover:-translate-y-1 hover:border-gray-200 hover:shadow-xl">
            <div class="relative overflow-hidden bg-gray-100">
              <a href="{{ product.url | within: collection }}" class="block">
                {% if primary_image != blank %}
                  <img
                    src="{{ primary_image | img_url: '720x' }}"
                    alt="{{ primary_image.alt | escape }}"
                    class="h-80 w-full object-cover transition duration-700 group-hover:scale-105"
                    loading="lazy">
                {% else %}
                  <div class="flex h-80 w-full items-center justify-center bg-gray-100 text-sm font-medium uppercase tracking-[0.4em] text-gray-400">
                    No image
                  </div>
                {% endif %}
              </a>
              {% if on_sale %}
                <span class="absolute left-5 top-5 inline-flex items-center rounded-full bg-black px-3 py-1 text-xs font-semibold uppercase tracking-widest text-white">
                  Sale
                </span>
              {% elsif product.available == false %}
                <span class="absolute left-5 top-5 inline-flex items-center rounded-full bg-gray-900/80 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-white">
                  Sold out
                </span>
              {% endif %}
              {% if secondary_image != blank %}
                <img
                  src="{{ secondary_image | img_url: '720x' }}"
                  alt="{{ secondary_image.alt | escape }}"
                  class="absolute inset-0 h-80 w-full object-cover opacity-0 transition duration-700 group-hover:opacity-100"
                  loading="lazy">
              {% endif %}
            </div>

            <div class="flex flex-col gap-5 px-6 py-7">
              <div>
                <h2 class="text-lg font-semibold text-gray-900">
                  <a href="{{ product.url | within: collection }}" class="transition hover:text-gray-600">
                    {{ product.title }}
                  </a>
                </h2>
                {% if product.vendor != blank %}
                  <p class="mt-1 text-xs font-medium uppercase tracking-[0.3em] text-gray-400">{{ product.vendor }}</p>
                {% endif %}
              </div>

              <div class="flex items-center justify-between">
                <div class="flex items-baseline gap-3">
                  <span class="text-lg font-semibold text-gray-900">{{ product.price | money }}</span>
                  {% if on_sale %}
                    <span class="text-sm font-medium text-gray-400 line-through">{{ product.compare_at_price_max | money }}</span>
                  {% endif %}
                </div>
                {% if product.available %}
                  <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] text-emerald-600">
                    <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                    In stock
                  </span>
                {% else %}
                  <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] text-rose-600">
                    <span class="h-2 w-2 rounded-full bg-rose-500"></span>
                    Unavailable
                  </span>
                {% endif %}
              </div>

              <div class="flex flex-col gap-3">
                {% if product.available %}
                  {% if product.has_only_default_variant %}
                    <form action="/cart/add" method="post" class="flex items-center gap-3">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="flex-1 rounded-full bg-gray-900 px-6 py-3 text-center text-sm font-semibold uppercase tracking-[0.3em] text-white transition hover:bg-gray-700">
                        Quick add
                      </button>
                      <a href="{{ product.url | within: collection }}" class="flex h-12 w-12 items-center justify-center rounded-full border border-gray-200 text-gray-500 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900" aria-label="View {{ product.title }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <circle cx="11" cy="11" r="7"/>
                          <path d="m20 20-3.5-3.5"/>
                        </svg>
                      </a>
                    </form>
                  {% else %}
                    <div class="flex items-center gap-3">
                      <a href="{{ product.url | within: collection }}" class="flex-1 rounded-full bg-gray-900 px-6 py-3 text-center text-sm font-semibold uppercase tracking-[0.3em] text-white transition hover:bg-gray-700">
                        Choose options
                      </a>
                      <a href="{{ product.url | within: collection }}" class="flex h-12 w-12 items-center justify-center rounded-full border border-gray-200 text-gray-500 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900" aria-label="View {{ product.title }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                      </a>
                    </div>
                  {% endif %}
                {% else %}
                  <a href="{{ product.url | within: collection }}" class="flex-1 rounded-full border border-gray-200 px-6 py-3 text-center text-sm font-semibold uppercase tracking-[0.3em] text-gray-400">
                    Sold out
                  </a>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="mt-16 rounded-3xl border border-dashed border-gray-200 bg-gray-50 px-10 py-16 text-center text-gray-500">
        <h2 class="text-lg font-semibold text-gray-700">Nothing to see here yet</h2>
        <p class="mt-2 text-sm">Add products to this collection to showcase them in style.</p>
      </div>
    {% endif %}

    {% if paginate.pages > 1 %}
      <nav class="mt-14 flex justify-center">
        <ul class="inline-flex items-center gap-2 text-sm font-medium text-gray-600">
          {% if paginate.previous %}
            <li>
              <a href="{{ paginate.previous.url }}" class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-gray-600 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900">
                <span aria-hidden="true">&larr;</span>
                Previous
              </a>
            </li>
          {% endif %}
          {% for part in paginate.parts %}
            <li>
              {% if part.is_link %}
                <a href="{{ part.url }}" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 text-gray-600 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900">
                  {{ part.title }}
                </a>
              {% elsif part.title == paginate.current_page %}
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-gray-900 text-sm font-semibold text-white">{{ part.title }}</span>
              {% else %}
                <span class="inline-flex h-10 w-10 items-center justify-center text-gray-400">{{ part.title }}</span>
              {% endif %}
            </li>
          {% endfor %}
          {% if paginate.next %}
            <li>
              <a href="{{ paginate.next.url }}" class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-gray-600 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900">
                Next
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          {% endif %}
        </ul>
      </nav>
    {% endif %}
  </div>
</section>
{% endpaginate %}
